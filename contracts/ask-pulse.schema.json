{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AskRequest": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "locale": {
          "default": "ru-KZ",
          "enum": [
            "ru-KZ",
            "kk-KZ"
          ],
          "title": "Locale",
          "type": "string"
        },
        "context_token": {
          "anyOf": [
            {
              "maxLength": 12000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Token"
        }
      },
      "required": [
        "question"
      ],
      "title": "AskRequest",
      "type": "object"
    },
    "Alert": {
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "format": "uuid",
          "title": "Alert Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "volume_spike",
            "incident_growth",
            "sla_risk",
            "data_quality",
            "model_drift"
          ],
          "title": "Type",
          "type": "string"
        },
        "region_id": {
          "title": "Region Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "enum": [
            "new",
            "acknowledged",
            "resolved",
            "dismissed"
          ],
          "title": "Status",
          "type": "string"
        },
        "detected_at": {
          "format": "date-time",
          "title": "Detected At",
          "type": "string"
        },
        "metric_id": {
          "enum": [
            "appeals_volume",
            "sla_risk",
            "source_freshness",
            "coverage"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "metric_version": {
          "title": "Metric Version",
          "type": "string"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Value"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "alert_id",
        "type",
        "region_id",
        "severity",
        "status",
        "detected_at",
        "metric_id",
        "metric_version",
        "baseline",
        "observed_value",
        "evidence"
      ],
      "title": "Alert",
      "type": "object"
    },
    "AnalyticsIntent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "analytics-intent-v1",
          "default": "analytics-intent-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "intent_type": {
          "enum": [
            "volume",
            "trend",
            "region_comparison",
            "topic_structure",
            "surge",
            "forecast",
            "bottlenecks"
          ],
          "title": "Intent Type",
          "type": "string"
        },
        "metric_id": {
          "default": "appeals_volume",
          "enum": [
            "appeals_volume",
            "sla_risk",
            "source_freshness",
            "coverage"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "region_ids": {
          "items": {
            "pattern": "^[A-Z0-9_-]{2,32}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Region Ids",
          "type": "array"
        },
        "topic_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Id"
        },
        "service_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Id"
        },
        "time_from": {
          "format": "date-time",
          "title": "Time From",
          "type": "string"
        },
        "time_to": {
          "format": "date-time",
          "title": "Time To",
          "type": "string"
        },
        "granularity": {
          "default": "day",
          "enum": [
            "hour",
            "day",
            "week",
            "month"
          ],
          "title": "Granularity",
          "type": "string"
        },
        "comparison": {
          "default": "none",
          "enum": [
            "none",
            "previous_period"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "horizon_days": {
          "anyOf": [
            {
              "maximum": 93,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon Days"
        },
        "visualization": {
          "default": "auto",
          "enum": [
            "auto",
            "kpi",
            "line",
            "bar",
            "forecast",
            "surge",
            "ranked_edges"
          ],
          "title": "Visualization",
          "type": "string"
        }
      },
      "required": [
        "intent_type",
        "time_from",
        "time_to"
      ],
      "title": "AnalyticsIntent",
      "type": "object"
    },
    "AnalyticsQuery": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "enum": [
            "appeals_volume",
            "sla_risk",
            "source_freshness",
            "coverage"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "metric_version": {
          "default": "1.0.0",
          "maxLength": 64,
          "minLength": 1,
          "title": "Metric Version",
          "type": "string"
        },
        "dimensions": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 5,
          "title": "Dimensions",
          "type": "array"
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/MetricFilter"
          },
          "maxItems": 10,
          "title": "Filters",
          "type": "array"
        },
        "time_from": {
          "format": "date-time",
          "title": "Time From",
          "type": "string"
        },
        "time_to": {
          "format": "date-time",
          "title": "Time To",
          "type": "string"
        },
        "granularity": {
          "default": "day",
          "enum": [
            "hour",
            "day",
            "week",
            "month"
          ],
          "title": "Granularity",
          "type": "string"
        },
        "limit": {
          "default": 1000,
          "maximum": 5000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "metric_id",
        "time_from",
        "time_to"
      ],
      "title": "AnalyticsQuery",
      "type": "object"
    },
    "AnalyticsResult": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "enum": [
            "appeals_volume",
            "sla_risk",
            "source_freshness",
            "coverage"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "metric_version": {
          "title": "Metric Version",
          "type": "string"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/MetricColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {},
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "computed_at": {
          "format": "date-time",
          "title": "Computed At",
          "type": "string"
        },
        "data_cutoff": {
          "format": "date-time",
          "title": "Data Cutoff",
          "type": "string"
        },
        "quality": {
          "enum": [
            "complete",
            "partial",
            "stale",
            "missing"
          ],
          "title": "Quality",
          "type": "string"
        },
        "coverage": {
          "additionalProperties": {
            "enum": [
              "present",
              "missing",
              "stale"
            ],
            "type": "string"
          },
          "title": "Coverage",
          "type": "object"
        },
        "missing_regions": {
          "items": {
            "type": "string"
          },
          "title": "Missing Regions",
          "type": "array"
        },
        "provenance": {
          "items": {
            "type": "string"
          },
          "title": "Provenance",
          "type": "array"
        },
        "records_considered": {
          "default": 0,
          "minimum": 0,
          "title": "Records Considered",
          "type": "integer"
        },
        "excluded_records": {
          "default": 0,
          "minimum": 0,
          "title": "Excluded Records",
          "type": "integer"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "synthetic": {
          "default": false,
          "title": "Synthetic",
          "type": "boolean"
        },
        "executed_query": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalyticsQuery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "metric_id",
        "metric_version",
        "columns",
        "rows",
        "computed_at",
        "data_cutoff",
        "quality",
        "coverage"
      ],
      "title": "AnalyticsResult",
      "type": "object"
    },
    "AskActions": {
      "additionalProperties": false,
      "properties": {
        "drilldown_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drilldown Url"
        },
        "export_query": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalyticsQuery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "export_formats": {
          "items": {
            "enum": [
              "pdf",
              "xlsx"
            ],
            "type": "string"
          },
          "title": "Export Formats",
          "type": "array"
        },
        "export_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Export Token"
        }
      },
      "title": "AskActions",
      "type": "object"
    },
    "AskAnswer": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "previous_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Total"
        },
        "change_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Pct"
        },
        "peak": {
          "anyOf": [
            {
              "$ref": "#/$defs/AskPeak"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "text"
      ],
      "title": "AskAnswer",
      "type": "object"
    },
    "AskChart": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "kpi",
            "line",
            "bar",
            "forecast",
            "surge",
            "ranked_edges"
          ],
          "title": "Type",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "string"
        },
        "y": {
          "title": "Y",
          "type": "string"
        },
        "series": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/MetricColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {},
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "type",
        "x",
        "y",
        "columns",
        "rows"
      ],
      "title": "AskChart",
      "type": "object"
    },
    "AskClarification": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "field",
        "prompt"
      ],
      "title": "AskClarification",
      "type": "object"
    },
    "AskInferenceMetadata": {
      "additionalProperties": false,
      "properties": {
        "requested_alias": {
          "enum": [
            "champion",
            "challenger",
            "baseline"
          ],
          "title": "Requested Alias",
          "type": "string"
        },
        "model_alias": {
          "enum": [
            "champion",
            "challenger",
            "baseline"
          ],
          "title": "Model Alias",
          "type": "string"
        },
        "model_name": {
          "title": "Model Name",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "tokenizer_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokenizer Revision"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "runtime": {
          "title": "Runtime",
          "type": "string"
        },
        "runtime_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Version"
        },
        "quantization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantization"
        },
        "prompt_version": {
          "const": "analytics-intent-prompt-v1",
          "default": "analytics-intent-prompt-v1",
          "title": "Prompt Version",
          "type": "string"
        },
        "schema_version": {
          "const": "analytics-intent-v1",
          "default": "analytics-intent-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "structured_output_valid": {
          "title": "Structured Output Valid",
          "type": "boolean"
        },
        "fallback_used": {
          "title": "Fallback Used",
          "type": "boolean"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "enum": [
                "baseline_requested",
                "context_rules",
                "question_refused",
                "model_not_configured",
                "registry_invalid",
                "model_timeout",
                "model_unavailable",
                "invalid_model_output"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "approval_state": {
          "enum": [
            "deterministic_baseline",
            "evaluation",
            "approved"
          ],
          "title": "Approval State",
          "type": "string"
        }
      },
      "required": [
        "requested_alias",
        "model_alias",
        "model_name",
        "runtime",
        "structured_output_valid",
        "fallback_used",
        "latency_ms",
        "approval_state"
      ],
      "title": "AskInferenceMetadata",
      "type": "object"
    },
    "AskPeak": {
      "additionalProperties": false,
      "properties": {
        "period": {
          "title": "Period",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "period",
        "value"
      ],
      "title": "AskPeak",
      "type": "object"
    },
    "AskProvenance": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "enum": [
            "appeals_volume",
            "sla_risk",
            "source_freshness",
            "coverage"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "metric_version": {
          "title": "Metric Version",
          "type": "string"
        },
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "time_from": {
          "format": "date-time",
          "title": "Time From",
          "type": "string"
        },
        "time_to": {
          "format": "date-time",
          "title": "Time To",
          "type": "string"
        },
        "data_cutoff": {
          "format": "date-time",
          "title": "Data Cutoff",
          "type": "string"
        },
        "computed_at": {
          "format": "date-time",
          "title": "Computed At",
          "type": "string"
        },
        "coverage": {
          "additionalProperties": {
            "enum": [
              "present",
              "missing",
              "stale"
            ],
            "type": "string"
          },
          "title": "Coverage",
          "type": "object"
        },
        "missing_regions": {
          "items": {
            "type": "string"
          },
          "title": "Missing Regions",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "excluded_records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excluded Records"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "metric_id",
        "metric_version",
        "definition",
        "time_from",
        "time_to",
        "data_cutoff",
        "computed_at",
        "coverage",
        "missing_regions",
        "source_refs"
      ],
      "title": "AskProvenance",
      "type": "object"
    },
    "Forecast": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "enum": [
            "appeals_volume",
            "sla_risk",
            "source_freshness",
            "coverage"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "metric_version": {
          "title": "Metric Version",
          "type": "string"
        },
        "region_id": {
          "title": "Region Id",
          "type": "string"
        },
        "data_cutoff": {
          "format": "date-time",
          "title": "Data Cutoff",
          "type": "string"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline"
        },
        "candidate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate"
        },
        "lower_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower Bound"
        },
        "upper_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper Bound"
        },
        "method": {
          "enum": [
            "seasonal_naive",
            "unavailable"
          ],
          "title": "Method",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "metric_version",
        "region_id",
        "data_cutoff",
        "baseline",
        "candidate",
        "lower_bound",
        "upper_bound",
        "method",
        "version"
      ],
      "title": "Forecast",
      "type": "object"
    },
    "MetricColumn": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "datetime",
            "boolean"
          ],
          "title": "Type",
