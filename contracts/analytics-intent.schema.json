{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AnalyticsIntent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "analytics-intent-v1",
          "default": "analytics-intent-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "intent_type": {
          "enum": [
            "volume",
            "trend",
            "region_comparison",
            "topic_structure",
            "surge",
            "forecast",
            "bottlenecks"
          ],
          "title": "Intent Type",
          "type": "string"
        },
        "metric_id": {
          "default": "appeals_volume",
          "enum": [
            "appeals_volume",
            "sla_risk",
            "source_freshness",
            "coverage"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "region_ids": {
          "items": {
            "pattern": "^[A-Z0-9_-]{2,32}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Region Ids",
          "type": "array"
        },
        "topic_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Id"
        },
        "service_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Id"
        },
        "time_from": {
          "format": "date-time",
          "title": "Time From",
          "type": "string"
        },
        "time_to": {
          "format": "date-time",
          "title": "Time To",
          "type": "string"
        },
        "granularity": {
          "default": "day",
          "enum": [
            "hour",
            "day",
            "week",
            "month"
          ],
          "title": "Granularity",
          "type": "string"
        },
        "comparison": {
          "default": "none",
          "enum": [
            "none",
            "previous_period"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "horizon_days": {
          "anyOf": [
            {
              "maximum": 93,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon Days"
        },
        "visualization": {
          "default": "auto",
          "enum": [
            "auto",
            "kpi",
            "line",
            "bar",
            "forecast",
            "surge",
            "ranked_edges"
          ],
          "title": "Visualization",
          "type": "string"
        }
      },
      "required": [
        "intent_type",
        "time_from",
        "time_to"
      ],
      "title": "AnalyticsIntent",
      "type": "object"
    },
    "IntentCatalog": {
      "additionalProperties": false,
      "description": "Aliases supplied by the approved regional catalog, never by a model.",
      "properties": {
        "region_aliases": {
          "patternProperties": {
            "^[A-Z0-9_-]{2,32}$": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Region Aliases",
          "type": "object"
        },
        "topic_aliases": {
          "patternProperties": {
            "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Topic Aliases",
          "type": "object"
        },
        "service_aliases": {
          "patternProperties": {
            "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Service Aliases",
          "type": "object"
        }
      },
      "title": "IntentCatalog",
      "type": "object"
    },
    "AnalyticsIntentRequest": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "analytics-intent-inference-v1",
          "default": "analytics-intent-inference-v1",
          "title": "Contract Version",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "locale": {
          "default": "ru-KZ",
          "enum": [
            "ru-KZ",
            "kk-KZ"
          ],
          "title": "Locale",
          "type": "string"
        },
        "reference_time": {
          "format": "date-time",
          "title": "Reference Time",
          "type": "string"
        },
        "catalog": {
          "$ref": "#/$defs/IntentCatalog"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalyticsIntent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_alias": {
          "default": "champion",
          "enum": [
            "champion",
            "challenger",
            "baseline"
          ],
          "title": "Model Alias",
          "type": "string"
        }
      },
      "required": [
        "question",
        "reference_time",
        "catalog"
      ],
      "title": "AnalyticsIntentRequest",
      "type": "object"
    },
    "AnalyticsIntentError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "clarification": {
          "anyOf": [
            {
              "$ref": "#/$defs/AskClarification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code"
      ],
      "title": "AnalyticsIntentError",
      "type": "object"
    },
    "AnalyticsIntentMetadata": {
      "additionalProperties": false,
      "properties": {
        "requested_alias": {
          "enum": [
            "champion",
            "challenger",
            "baseline"
          ],
          "title": "Requested Alias",
          "type": "string"
        },
        "model_alias": {
          "enum": [
            "champion",
            "challenger",
            "baseline"
          ],
          "title": "Model Alias",
          "type": "string"
        },
        "model_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "tokenizer_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokenizer Revision"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "runtime": {
          "title": "Runtime",
          "type": "string"
        },
        "runtime_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Version"
        },
        "quantization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantization"
        },
        "prompt_version": {
          "const": "analytics-intent-prompt-v1",
          "default": "analytics-intent-prompt-v1",
          "title": "Prompt Version",
          "type": "string"
        },
        "schema_version": {
          "const": "analytics-intent-v1",
          "default": "analytics-intent-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "structured_output_valid": {
          "title": "Structured Output Valid",
          "type": "boolean"
        },
        "fallback_used": {
          "title": "Fallback Used",
          "type": "boolean"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "enum": [
                "baseline_requested",
                "context_rules",
                "question_refused",
                "model_not_configured",
                "registry_invalid",
                "model_timeout",
                "model_unavailable",
                "invalid_model_output"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "approval_state": {
          "enum": [
            "deterministic_baseline",
            "evaluation",
            "approved"
          ],
          "title": "Approval State",
          "type": "string"
        }
      },
      "required": [
        "requested_alias",
        "model_alias",
        "model_name",
        "runtime",
        "structured_output_valid",
        "fallback_used",
        "latency_ms",
        "approval_state"
      ],
      "title": "AnalyticsIntentMetadata",
      "type": "object"
    },
    "AskClarification": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "field",
        "prompt"
      ],
      "title": "AskClarification",
      "type": "object"
    },
    "AnalyticsIntentResponse": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "analytics-intent-inference-v1",
          "default": "analytics-intent-inference-v1",
          "title": "Contract Version",
          "type": "string"
        },
        "intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalyticsIntent"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalyticsIntentError"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "$ref": "#/$defs/AnalyticsIntentMetadata"
        }
      },
      "required": [
        "intent",
        "error",
        "metadata"
      ],
      "title": "AnalyticsIntentResponse",
      "type": "object"
    }
  }
}
