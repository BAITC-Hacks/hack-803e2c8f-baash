{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse109.local/contracts/inference/1.0.0",
  "title": "Pulse 109 Internal Inference Envelope",
  "oneOf": [
    { "$ref": "#/$defs/InferenceRequest" },
    { "$ref": "#/$defs/InferenceResponse" },
    { "$ref": "#/$defs/InferenceFailure" }
  ],
  "$defs": {
    "RankedLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rank", "score"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "InferenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "task",
        "request_id",
        "request_version",
        "region_id",
        "language",
        "feature_snapshot_id",
        "redacted_text",
        "input_contract_version",
        "preprocess_version",
        "taxonomy_version",
        "model_alias",
        "correlation_id",
        "trace_id",
        "requested_at"
      ],
      "properties": {
        "kind": { "const": "request" },
        "contract_version": { "const": "1.0.0" },
        "task": { "const": "routing" },
        "request_id": { "type": "string", "format": "uuid" },
        "request_version": { "type": "integer", "minimum": 1 },
        "region_id": { "type": "string", "pattern": "^[A-Z0-9_-]{2,32}$" },
        "language": { "enum": ["kk", "ru", "mixed", "unknown"] },
        "feature_snapshot_id": { "type": "string", "format": "uuid" },
        "redacted_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "input_contract_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "preprocess_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "taxonomy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model_alias": {
          "enum": ["champion", "challenger", "baseline", "mock"]
        },
        "channel": {
          "enum": [
            "phone",
            "web",
            "mobile",
            "telegram",
            "whatsapp",
            "email",
            "walk_in",
            "import",
            "other"
          ]
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "trace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requested_at": { "type": "string", "format": "date-time" },
        "data_classification": { "const": "internal-redacted" }
      }
    },
    "InferenceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "recommendation_id",
        "request_id",
        "request_version",
        "task",
        "model_name",
        "model_alias",
        "model_version",
        "artifact_sha256",
        "input_contract_version",
        "preprocess_version",
        "taxonomy_version",
        "feature_snapshot_id",
        "top_topics",
        "top_services",
        "priority",
        "confidence",
        "confidence_band",
        "ood_state",
        "ood_score",
        "fallback_mode",
        "requires_human_confirmation",
        "latency_ms",
        "correlation_id",
        "trace_id",
        "produced_at"
      ],
      "properties": {
        "kind": { "const": "response" },
        "contract_version": { "const": "1.0.0" },
        "recommendation_id": { "type": "string", "format": "uuid" },
        "request_id": { "type": "string", "format": "uuid" },
        "request_version": { "type": "integer", "minimum": 1 },
        "task": { "const": "routing" },
        "model_name": { "type": "string", "minLength": 1 },
        "model_alias": {
          "enum": ["champion", "challenger", "baseline", "mock"]
        },
        "model_version": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "input_contract_version": { "type": "string", "minLength": 1 },
        "preprocess_version": { "type": "string", "minLength": 1 },
        "taxonomy_version": { "type": "string", "minLength": 1 },
        "feature_snapshot_id": { "type": "string", "format": "uuid" },
        "top_topics": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/RankedLabel" }
        },
        "top_services": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/RankedLabel" }
        },
        "priority": {
          "enum": ["routine", "elevated", "urgent", "emergency_handoff"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence_band": {
          "enum": ["high", "medium", "low", "out_of_domain"]
        },
        "ood_state": { "enum": ["in_domain", "out_of_domain"] },
        "ood_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "fallback_mode": {
          "enum": ["linear_cpu", "lexical_cpu", "mock", "rules_only"]
        },
        "rule_hits": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "missing_fields": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "requires_human_confirmation": { "const": true },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "trace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "produced_at": { "type": "string", "format": "date-time" }
      }
    },
    "InferenceFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "error_code",
        "retryable",
        "correlation_id",
        "trace_id"
      ],
      "properties": {
        "kind": { "const": "failure" },
        "contract_version": { "const": "1.0.0" },
        "error_code": { "type": "string", "pattern": "^[a-z0-9_]{3,64}$" },
        "retryable": { "type": "boolean" },
        "model_version": { "type": ["string", "null"] },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "trace_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
