# Public edge for Pulse 109.
#
# Caddy is here for one reason: it obtains and renews a certificate without a
# separate agent, a cron job or a renewal that somebody forgets. On a demo
# server, an expired certificate is the failure that happens while nobody is
# watching.
#
# Everything the internet can reach is in this file. The API, the database, the
# worker and the adapters are reachable only from inside the Compose network.

{$PULSE109_PUBLIC_DOMAIN} {
	encode zstd gzip

	# The browser calls /api/core/... and Next.js proxies it to the API, so the
	# edge does not need to know about the API at all. Keeping one entry point
	# means there is one place where a route can be exposed by accident.
	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# This is a demo environment holding synthetic municipal records. The
		# header says so to anything that indexes or archives the page.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	log {
		output stdout
		format json
		# Request paths carry appeal identifiers. They are synthetic here, but
		# the habit of logging them is the one that survives into production.
		level WARN
	}
}

# Anything arriving on a name that is not the configured domain gets nothing.
# A default site would otherwise serve the application on the raw IP address.
:80 {
	respond 421
}
