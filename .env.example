PULSE109_ENVIRONMENT=local
PULSE109_DATABASE_URL=postgresql+psycopg://pulse109:pulse109-local@localhost:5432/pulse109
PULSE109_READINESS_DATABASE_REQUIRED=true
PULSE109_LOG_LEVEL=INFO
PULSE109_LOCAL_IDENTITY_ENABLED=true
PULSE109_MANUAL_REPOSITORY_MODE=postgres
# Set both values from an approved regional policy before pilot/production intake.
# PULSE109_APPROVED_LEGAL_BASIS=
# PULSE109_APPROVED_RETENTION_CLASS=
PULSE109_OIDC_ISSUER=
PULSE109_OIDC_AUDIENCE=
PULSE109_OIDC_JWKS_URL=
PULSE109_OIDC_ALGORITHMS=["RS256"]
PULSE109_OTEL_ENABLED=true
PULSE109_OTEL_EXPORTER_ENDPOINT=
PULSE109_OTEL_SAMPLE_RATIO=0.1
PULSE109_WORKER_ENABLED=true
NEXT_PUBLIC_MARTIN_TILE_URL=
# Enable only for local synthetic UI trials; browser submission stays disabled by default.
NEXT_PUBLIC_PULSE109_SYNTHETIC_ASSIST=false
POSTGRES_DB=pulse109
POSTGRES_USER=pulse109
POSTGRES_PASSWORD=pulse109-local
MINIO_ROOT_USER=pulse109-local
MINIO_ROOT_PASSWORD=pulse109-local-secret
